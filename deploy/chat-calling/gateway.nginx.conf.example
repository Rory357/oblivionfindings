# Merge these blocks into the appropriate top-level Nginx contexts.
# Requires stream, ssl_preread, http_ssl and http_auth_request modules.
# All example.invalid hosts, addresses and certificate paths must be replaced.
stream {
    map $ssl_preread_server_name $oblivion_voice_destination {
        voice.example.invalid 127.0.0.1:8443;
        turn.example.invalid 127.0.0.1:5349;
        default 127.0.0.1:9;
    }
    server {
        listen 443;
        ssl_preread on;
        proxy_pass $oblivion_voice_destination;
        proxy_protocol on;
        proxy_timeout 3600s;
    }
}

http {
    upstream oblivion_private_app {
        # The application service reachable over a protected internal network.
        server REPLACE_WITH_PRIVATE_APP_ADDRESS:80;
    }
    server {
        listen 127.0.0.1:8443 ssl proxy_protocol;
        set_real_ip_from 127.0.0.1;
        real_ip_header proxy_protocol;
        server_name voice.example.invalid;
        ssl_certificate /etc/oblivion-voice/voice/fullchain.pem;
        ssl_certificate_key /etc/oblivion-voice/voice/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        # Query-string credentials must not enter request/error logs.
        access_log off;
        error_log /dev/null;
        location /rtc {
            set $oblivion_chat_token $arg_access_token;
            auth_request /_oblivion_chat_authorize;
            proxy_pass http://127.0.0.1:7880;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_read_timeout 3600s;
        }
        location = /_oblivion_chat_authorize {
            internal;
            proxy_pass http://oblivion_private_app/api/chat/calling/authorize;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header X-Chat-Access-Token $oblivion_chat_token;
            proxy_set_header Host oblivion.example.invalid;
        }
        location / { return 404; }
    }
    server {
        listen REPLACE_WITH_PRIVATE_VOICE_ADDRESS:8444 ssl;
        server_name voice-api.example.invalid;
        ssl_certificate /etc/oblivion-voice/api/fullchain.pem;
        ssl_certificate_key /etc/oblivion-voice/api/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        allow REPLACE_WITH_PRIVATE_APP_ADDRESS;
        deny all;
        access_log off;
        error_log /dev/null;
        location /twirp/livekit.RoomService/ {
            proxy_pass http://127.0.0.1:7880;
            proxy_set_header Authorization $http_authorization;
        }
        location / { return 404; }
    }
}
