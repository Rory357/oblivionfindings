# Oblivion Relay configuration example (spec: docs/chat-experience/clean-room/specs/oblivion-relay.md 10.2).
# Do not activate before the clean-room checker has signed it off and the user has said yes.
# Install steps: deploy/chat-calling/oblivion-relay.md. Copy to /etc/oblivion/relay.env (root:oblivion-relay, 0640).
# Every value is checked at start; a wrong one stops the relay with a message naming the setting.
#
# The main example is the test server that runs main (shape B, spec 10.3): beside nginx, while
# LiveKit still owns turn.<domain>, UDP 3478 and 127.0.0.1:5349.

# --- Names and listeners ---------------------------------------------------------------------
# The REALM: the relay's DNS name, at most 32 characters.
RELAY_REALM=relay.oblivionfindings.com
# Listeners: udp, tcp, tls or tcp+tls, then ://host:port, optionally ?proxy=required (nginx sends PROXY v1).
RELAY_LISTEN=udp://0.0.0.0:3479,tls://127.0.0.1:5350?proxy=required
# The IPv4 address relayed sockets bind to: 0.0.0.0, or the private address of a 1:1 NAT.
RELAY_LISTEN_IP=0.0.0.0
# The server's public IPv4, given to browsers as the relayed address. Required.
RELAY_EXTERNAL_IP=
# IPv6 relaying is on only when both are set. Leave empty unless the server has IPv6.
RELAY_LISTEN_IPV6=
RELAY_EXTERNAL_IPV6=
# The relayed UDP range: above Linux's ephemeral range and clear of LiveKit (4,000 ports).
RELAY_PORT_MIN=61000
RELAY_PORT_MAX=64999
# PEM full chain and key for relay.oblivionfindings.com, copied here by the renewal hook.
RELAY_TLS_CERT_FILE=/etc/oblivion/relay/tls/fullchain.pem
RELAY_TLS_KEY_FILE=/etc/oblivion/relay/tls/privkey.pem
# Who may send a PROXY header: nginx on this host.
RELAY_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# --- The chat class (spec 3.2). The cctv and remote classes are deferred: never set RELAY_CCTV_* or
# RELAY_REMOTE_*, which stops start-up. ----------------------------------------------------------
# The same secret as the app's CHAT_RELAY_SECRET, 32-512 bytes. Files are preferred (re-read on SIGHUP);
# use RELAY_CHAT_SECRET=... instead only if a file isn't possible, never both.
RELAY_CHAT_SECRET_FILE=/etc/oblivion/relay/chat.secret
# Only while rotating (spec 3.4): the old secret, so calls already set up keep working. The file stays
# in place, empty, between rotations: an empty file means no previous secret.
RELAY_CHAT_PREVIOUS_SECRET_FILE=/etc/oblivion/relay/chat-previous.secret
# Longest credential the app may issue, in seconds (at most 3600).
RELAY_CHAT_MAX_CREDENTIAL_SECONDS=3600
# How long an allocation may keep refreshing after its credential expires (at most 14400: the five-hour call).
RELAY_CHAT_GRACE_SECONDS=14400
# Peer policy: public (any global address) or relay-only.
RELAY_CHAT_PEERS=public
# Extra peer ranges for chat only, up to 8 CIDRs of /24 (IPv4) or /120 (IPv6) or narrower. Empty by default.
RELAY_CHAT_ALLOWED_PEER_CIDRS=
# Allocations per person per call (an 8-person call may need 42).
RELAY_CHAT_MAX_ALLOCATIONS=48
# Bandwidth per allocation and per person per call, each direction, in kbit/s.
RELAY_CHAT_ALLOCATION_KBPS=4000
RELAY_CHAT_ID_KBPS=16000

# --- Relay-wide limits (spec 7) -------------------------------------------------------------------
# Allocations in total; leaves ports spare in the 4,000-port range.
RELAY_MAX_ALLOCATIONS=3000
# Allocations per client IP (care homes put many staff behind one address).
RELAY_MAX_ALLOCATIONS_PER_IP=500
# Permissions and channels per allocation.
RELAY_MAX_PERMISSIONS=64
RELAY_MAX_CHANNELS=64
# Relayed traffic in total, each direction, in Mbit/s: 100, or half the link speed if that is lower.
RELAY_TOTAL_MBPS=100
# TCP and TLS connections in total and per client IP.
RELAY_MAX_CONNECTIONS=8000
RELAY_MAX_CONNECTIONS_PER_IP=256
# Unauthenticated replies (401, Binding, early 400 and 420) per client IP and in total, per second.
RELAY_UNAUTH_PER_IP_PER_SECOND=10
RELAY_UNAUTH_PER_SECOND=2000
# Failed authentications per client IP per minute before it is ignored for 60 s.
RELAY_AUTH_FAILURES_PER_MINUTE=20
# Peer ports always refused, on top of 0-1023, 3478 and 5349.
RELAY_DENIED_PEER_PORTS=1900,3702,5353,5355,11211

# --- Timings and features --------------------------------------------------------------------------
# Longest allocation lifetime per Refresh, 600-3600 seconds.
RELAY_MAX_LIFETIME_SECONDS=3600
# How long a nonce is valid, in seconds.
RELAY_NONCE_SECONDS=600
# Clock allowance for credential expiry and held revocations, in seconds.
RELAY_CLOCK_SKEW_SECONDS=30
# STUN Binding (browsers learn their public address, so more calls go direct): on or off.
RELAY_STUN_BINDING=on

# --- Health, logs and state (spec 9) ------------------------------------------------------------------
# Health and metrics, loopback only. The app reads /health here (CHAT_RELAY_HEALTH_URL).
RELAY_HEALTH_LISTEN=127.0.0.1:9478
# error, warn, info or debug (debug adds nothing secret).
RELAY_LOG_LEVEL=info
# The allocation log (client IPs): oblivion-relay:oblivion-relay-logs, mode 2750. Exclude it from backups.
RELAY_LOG_DIR=/var/log/oblivion-relay
# Days the allocation log is kept, 1-90 (the user chose 14 on 1 November 2026).
RELAY_LOG_RETENTION_DAYS=14
# Optional deny file (spec 3.5): one opaque id or expiry:opaque-id per line; re-read on SIGHUP.
RELAY_DENY_FILE=/etc/oblivion/relay/deny
# Holds revocations.json; systemd's StateDirectory creates it.
RELAY_STATE_DIR=/var/lib/oblivion-relay

# --- The control channel (spec 3.7) ---------------------------------------------------------------
# Loopback here. On a server of its own: the relay's private address (cloud private network or WireGuard).
RELAY_CONTROL_LISTEN=127.0.0.1:9479
# Who may call it: loopback and private CIDRs only. On its own server: the app server's private address.
RELAY_CONTROL_ALLOWED_SOURCES=127.0.0.1/32,::1/128
# Its own secret, different from every credential secret, and its key id (a short name such as k2026a,
# in a file of its own). The app's CHAT_RELAY_CONTROL_* match. Both files are re-read on SIGHUP, so
# rotating the control key never drops a call (the user's choice, 1 November 2026).
RELAY_CONTROL_SECRET_FILE=/etc/oblivion/relay/control.secret
RELAY_CONTROL_KEY_ID_FILE=/etc/oblivion/relay/control.key-id
# Only while rotating the control key; both files stay in place, empty, between rotations.
RELAY_CONTROL_PREVIOUS_SECRET_FILE=/etc/oblivion/relay/control-previous.secret
RELAY_CONTROL_PREVIOUS_KEY_ID_FILE=/etc/oblivion/relay/control-previous.key-id

# --- Shape A, a server of its own (spec 10.4), for later. Replace the matching lines above. ------
# RELAY_REALM=turn.oblivionfindings.com
# RELAY_LISTEN=udp://0.0.0.0:3478,tcp://0.0.0.0:3478,tcp+tls://0.0.0.0:443
# RELAY_PORT_MIN=49152
# RELAY_PORT_MAX=65535
# RELAY_MAX_ALLOCATIONS=4000
# RELAY_TOTAL_MBPS=200
# RELAY_CONTROL_LISTEN=10.0.0.5:9479
# RELAY_CONTROL_ALLOWED_SOURCES=10.0.0.4/32

# =====================================================================================================
# The app (.env on the app server). Leave these empty until the relay is running.
# =====================================================================================================
# UDP first, then TCP, then TLS. Shape A adds turn:turn.<domain>:3478?transport=tcp and uses port 443 for turns:.
# CHAT_RELAY_URLS=turn:relay.oblivionfindings.com:3479?transport=udp,turns:relay.oblivionfindings.com:443?transport=tcp
# CHAT_RELAY_SECRET=
# CHAT_RELAY_CREDENTIAL_SECONDS=3600
# Beside the app only: the relay's loopback health endpoint. Leave empty when the relay has its own server.
# CHAT_RELAY_HEALTH_URL=http://127.0.0.1:9478
# One URL per relay node: http, a literal loopback or private IP with a port, no path.
# CHAT_RELAY_CONTROL_URLS=http://127.0.0.1:9479
# CHAT_RELAY_CONTROL_SECRET=
# CHAT_RELAY_CONTROL_KEY_ID=k2026a
# CHAT_HEALTH_RELAY_OWNER=
#
# The existing CCTV_TURN_* and ENDPOINT_REMOTE_RELAY_* keys are NOT pointed at this relay in version 1:
# CCTV live view and IT remote support are deferred (spec 3.2). Leave them as they are.
