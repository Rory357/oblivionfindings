# Include inside the existing application HTTPS server block.
# Unactivated example: validate with nginx -t on the target host.
# Oblivion Live serves exactly /chat-live; the path is passed through unchanged.
# Never expose the gateway's internal API port (LIVE_INTERNAL_PORT) through nginx.
location = /chat-live {
    proxy_pass http://127.0.0.1:8091;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header Origin $http_origin;
    # The gateway pings every 25 seconds, well inside this.
    proxy_read_timeout 75s;
    proxy_send_timeout 75s;
    proxy_buffering off;
    access_log off;
}
location ^~ /chat-live/ {
    return 404;
}
