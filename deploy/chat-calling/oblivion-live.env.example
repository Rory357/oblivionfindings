# Oblivion Live configuration example. Do not activate before acceptance.
# See deploy/chat-calling/chat-realtime.md.

# --- The gateway (node live/server.mjs), in its own environment file ---
# Browser connections arrive through nginx at /chat-live on this loopback port.
LIVE_PORT=8091
# The app's signed API. Always bound to 127.0.0.1; never proxied outside.
LIVE_INTERNAL_PORT=8092
# The same secret and key ID as the app's CHAT_LIVE_SECRET and CHAT_LIVE_KEY_ID.
# At least 32 random characters, from the deployment secret store.
LIVE_SECRET=
LIVE_KEY_ID=
# Only while rotating: the old secret and its key ID, so tickets already issued still work.
LIVE_PREVIOUS_SECRET=
LIVE_PREVIOUS_KEY_ID=
# Exact browser origins, comma-separated, no wildcard. Empty refuses every browser.
LIVE_ALLOWED_ORIGINS=
# The app's own address, for presence reports (POST /chat/api/live/presence).
LIVE_APP_URL=
# Connections one node accepts before answering 503.
LIVE_MAX_CONNECTIONS=10000

# --- The app (.env) ---
CHAT_SHARED_EXPERIENCE=false
CHAT_LIVE_ENABLED=false
# Comma-separate the internal addresses when more than one gateway node runs.
CHAT_LIVE_INTERNAL_URL=http://127.0.0.1:8092
CHAT_LIVE_SECRET=
CHAT_LIVE_KEY_ID=
CHAT_LIVE_PREVIOUS_SECRET=
CHAT_LIVE_PREVIOUS_KEY_ID=
CHAT_LIVE_ALLOWED_ORIGINS=
