# Include inside the existing application HTTPS server block.
# Unactivated example: validate with nginx -t on the target host.
# Strip /chat-live so Reverb receives /app/{public-key}.
# Never expose Reverb's signed REST publishing API (/apps) through this location.
location ^~ /chat-live/app/ {
    proxy_pass http://127.0.0.1:8085/app/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header Origin $http_origin;
    proxy_read_timeout 90s;
    proxy_send_timeout 90s;
    proxy_buffering off;
    access_log off;
}
location /chat-live/ {
    return 404;
}
