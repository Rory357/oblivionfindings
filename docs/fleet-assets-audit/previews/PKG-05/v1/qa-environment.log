 const before=await measure();await page.keyboard.press('Control+Equal');await page.keyboard.press('Control+Equal');await page.waitForTimeout(200);const after=await measure();await page.keyboard.press('Control+0');
 await page.emulateMedia({reducedMotion:'no-preference'});await page.getByRole('button',{name:'Request transport',exact:true}).first().click();await page.waitForTimeout(500);
 const animations=await page.evaluate(()=>[...document.querySelectorAll('[role=dialog]')].map(e=>({state:e.getAttribute('data-state'),opacity:getComputedStyle(e).opacity,animations:e.getAnimations().map(a=>({state:a.playState,time:a.currentTime}))})));
 await page.screenshot({path:'screenshots/19-normal-motion-request.png',animations:'disabled'});
 await page.emulateMedia({reducedMotion:'reduce'});await page.goto('http://127.0.0.1:4395/');
 return {zoomAttempt:{before,after,verified:after.width!==before.width||after.dpr!==before.dpr},normalMotion:animations,pageErrors:errors,requests};
