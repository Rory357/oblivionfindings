  "method_limit": "Official propositions frame product/code risk. They are kept separate from Oblivion source observation, audit inference and accountable owner decisions. This is not legal advice, clinical/security certification or regulatory attestation.",
  "source_definitions": {
    "HISF-ACCESS": "HISF authorised, need-to-know, least-privilege access and access lifecycle.",
    "HISF-APPSEC": "HISF documented/approved application-security requirements, risk assessment, secure coding and testing.",
    "HISF-WEB": "HISF authorised web access and secure-by-design/default web controls.",
    "HISF-TLS": "HISF current TLS and protected communications guidance.",
    "HISF-LIFECYCLE": "HISF protection of copies plus governed retention, disposal, backup and recovery.",
    "HISF-LOG": "HISF protected, role-limited and alteration-resistant logging.",
    "HISF-SOD": "HISF segregation-of-duties control frame; exact business separation remains owner-defined.",
    "HISF-BCDR": "HISF incident management, evidence protection and continuity/recovery.",
    "HISF-SCOPE": "HISF system/security scope context; it does not establish privacy-law rights.",
    "MMH-BOLA": "Current Ministry Manage My Health review identifies authenticated cross-record access as broken object-level authorisation under HISF Protect.",
    "HIPC-R3A": "HIPC Rule 3A qualifying indirect-collection notice from 1 May 2026, subject to scope and exceptions.",
    "HIPC-R5": "HIPC Rule 5 health-information storage/security and minimum-access context.",
    "HIPC-R6": "HIPC Rule 6 access-request context.",
    "HIPC-R9": "HIPC Rule 9 retention context; record class, schedule and hold decisions remain owner-defined.",
    "HIPC-R11": "HIPC disclosure/representative context; it does not establish an individual's authority.",
    "HIPC-REP": "HIPC representative/requester context; actual entitlement requires verification.",
    "PA-IPP3A": "Privacy Act IPP3A qualifying indirect-collection notice, subject to scope and exceptions.",
    "PA-IPP5": "Privacy Act Principle 5 storage/security context for personal information not proven to be health information.",
    "PA-IPP6-7": "Privacy Act access/correction rights; not a general erasure/portability right.",
    "HDC-R4": "Code of Rights service-quality/safety context; exact application mechanism remains clinical/product-defined.",
    "HDC-R7": "Code of Rights informed choice/consent and presumed-competence context.",
    "WS-NOTIFY": "WorkSafe notifiable-event, preservation and record guidance; it does not prescribe Oblivion lifecycle/RBAC design.",
    "WS-NOTIFY(scope-only)": "WorkSafe notification context only; no site-RBAC requirement is inferred.",
    "WS-RISK": "WorkSafe risk-management context; exact application approval mechanics remain H&S-owner-defined.",
    "NZS-SCOPE": "Ngā Paerewa modular service/certification scope; it does not mandate the exact Oblivion control.",
    "NZS-CERT": "Ngā Paerewa/HealthCERT certificate evidence and modular scope; unsupported UI assertion is proven, provider non-certification is not.",
    "OWNER-*": "The source frames the issue but does not mandate the exact Oblivion control; named specialist owns applicability and design."
  },
