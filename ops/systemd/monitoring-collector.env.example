# Copy to /etc/oblivion/monitoring-collector.env as root:root mode 0600.
# Values must be absolute paths without shell expansion. Do not add enrolment
# tokens, credential leases, private keys, or reusable secrets to this file.
OBLIVION_COLLECTOR_PHP_BINARY=/usr/bin/php8.4
OBLIVION_COLLECTOR_ARTIFACT_DIR=/opt/oblivion-monitoring-collector/current
OBLIVION_COLLECTOR_IDENTITY_FILE=/var/lib/oblivion-monitoring-collector/collector.identity.json
OBLIVION_COLLECTOR_CONFIG_FILE=/var/lib/oblivion-monitoring-collector/collector.json
