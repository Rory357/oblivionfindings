APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_INDEXING_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Healthcare: Use 'daily' for log rotation in production
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PRODUCTION REQUIRED: Configure Sentry for error monitoring
# Sentry Error Monitoring (optional, recommended for production)
# Get your DSN from https://sentry.io/
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=oblivion_findings
DB_USERNAME=testUser
DB_PASSWORD='test101'

SESSION_DRIVER=database
# Healthcare standard: 60 min idle timeout
SESSION_LIFETIME=60
# PRODUCTION: Must be true for healthcare compliance
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcasting: set to 'reverb' or 'pusher' for real-time WebSocket support
# See: php artisan install:broadcasting
BROADCAST_CONNECTION=log

# Laravel Reverb (WebSocket server) — uncomment when using Reverb
# REVERB_APP_ID=my-app-id
# REVERB_APP_KEY=my-app-key
# REVERB_APP_SECRET=my-app-secret
# REVERB_HOST=localhost
# REVERB_PORT=8080
# REVERB_SCHEME=http
# VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# VITE_REVERB_HOST="${REVERB_HOST}"
# VITE_REVERB_PORT="${REVERB_PORT}"
# VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local

# PRODUCTION: Use redis for performance (see REDIS_SETUP.md)
QUEUE_CONNECTION=redis

# PRODUCTION: Use redis for performance (see REDIS_SETUP.md)
CACHE_STORE=redis

# LLM (optional)
# Set LLM_DRIVER=openai and provide OPENAI_API_KEY to enable AI summaries.
LLM_DRIVER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Use 'predis' (composer package) or 'phpredis' (PHP extension)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Rotate these provider webhook secrets through the deployment secret store.
# Empty values keep the inbound and delivery-status endpoints fail-closed.
IT_INBOUND_MAIL_SECRET=
IT_OUTBOUND_MAIL_STATUS_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Rostering rollout flags.
# Playwright enables these via playwright.config.ts for rostering E2E runs.
# Set both to true locally when testing publish and auto-schedule outside Playwright.
FEATURE_ROSTERING_PUBLISH=false
FEATURE_ROSTERING_AUTO_SCHEDULE=false
FEATURE_ROSTERING_AUTO_SCHEDULE_QUEUE_THRESHOLD=1000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Microsoft (Entra ID)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
MICROSOFT_TENANT_ID=

# Telemetry ingest
TELEMETRY_INGEST_TOKEN=

# Native Queclink TCP intake pressure and privacy bounds
QUECLINK_LISTENER_PORT=8090
QUECLINK_PUBLIC_HOSTNAME=
QUECLINK_MAX_CONNECTIONS=256
QUECLINK_MAX_CONNECTIONS_PER_SOURCE=64
QUECLINK_MAX_TRACKED_SOURCES=4096
QUECLINK_CONNECTION_ATTEMPTS_PER_WINDOW=120
QUECLINK_CONNECTION_WINDOW_SECONDS=60
QUECLINK_IDLE_TIMEOUT_SECONDS=900
QUECLINK_MAX_FRAME_BYTES=16384
QUECLINK_MAX_BUFFER_BYTES=32768
QUECLINK_FRAMES_PER_WINDOW=240
QUECLINK_INVALID_FRAMES_PER_WINDOW=20
QUECLINK_FRAME_WINDOW_SECONDS=60
QUECLINK_RAW_FRAME_RETENTION_DAYS=30

# Native monitoring runtime
MONITORING_QUEUE_CONNECTION=redis
MONITORING_SEQUENCE_LOCK_STORE=redis
SECURITY_DEVICES_COMMAND_QUEUE=monitoring-commands
MONITORING_SIGNING_KEY_ID=
# JSON object mapping key IDs to base64-encoded 32-byte sodium crypto_auth keys.
# Shape only: {"<key-id>":"<base64-encoded-key>"}. Keep actual key material secret.
MONITORING_SIGNING_KEYS={}
MONITORING_CREDENTIAL_DRIVER=unavailable
MONITORING_CREDENTIAL_LEASE_TTL_SECONDS=60
MONITORING_VAULT_URL=
MONITORING_VAULT_TOKEN=
MONITORING_VAULT_NAMESPACE=
MONITORING_COLLECTOR_SIGNING_SECRET_KEY=
MONITORING_COLLECTOR_TRUSTED_PROXY_CIDRS=
MONITORING_COLLECTOR_CA_CERTIFICATE_PATH=
MONITORING_COLLECTOR_CA_PRIVATE_KEY_PATH=
MONITORING_COLLECTOR_CA_PRIVATE_KEY_PASSPHRASE=
MONITORING_COLLECTOR_REPLAY_STORE=redis
MONITORING_COLLECTOR_ALLOW_PROXY_FINGERPRINT_HEADER=false
MONITORING_ALLOW_LOCAL_COLLECTOR_REPLAY_FOR_TESTS=false
MONITORING_TIMESERIES_URL=
MONITORING_TIMESERIES_ORG=
MONITORING_TIMESERIES_BUCKET=
MONITORING_TIMESERIES_TOKEN=
MONITORING_SNAPSHOT_DISK=private
# Isolated restore rehearsal only. Supply separate non-production credentials.
MONITORING_RESTORE_FILESYSTEM_DRIVER=local
MONITORING_RESTORE_FILESYSTEM_ROOT=
MONITORING_RESTORE_OBJECT_ACCESS_KEY_ID=
MONITORING_RESTORE_OBJECT_SECRET_ACCESS_KEY=
MONITORING_RESTORE_OBJECT_REGION=
MONITORING_RESTORE_OBJECT_BUCKET=
MONITORING_RESTORE_OBJECT_ENDPOINT=
MONITORING_RESTORE_OBJECT_PATH_STYLE=false
MONITORING_RESTORE_VAULT_URL=
# Bind only on the interface used by the approved Site-network path. Keep the
# PHP worker unprivileged; terminate/redirect the standard UDP/162 edge port to
# this high local port in the reviewed firewall or Site-network relay.
MONITORING_SNMP_TRAP_BIND=127.0.0.1
MONITORING_SNMP_TRAP_PORT=1162
MONITORING_INBOUND_BIND_ALLOWLIST=127.0.0.1,::1
MONITORING_LISTENER_STATE_STORE=redis
MONITORING_EXTERNAL_HEARTBEAT_ENABLED=false
MONITORING_EXTERNAL_HEARTBEAT_URL=
MONITORING_EXTERNAL_HEARTBEAT_ALLOWED_HOSTS=
MONITORING_SYSLOG_BIND=127.0.0.1
MONITORING_SYSLOG_PORT=5514
MONITORING_FLOW_BIND=127.0.0.1
MONITORING_FLOW_PORT=2055
MILESIGHT_ALLOWED_HOSTS=mdp-api.milesight.com

# Xero accounting sync
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# IRD e-filing
IRD_API_KEY=
IRD_API_SECRET=

# Finance bank-feed providers
FINANCE_BANK_FEED_PROVIDER_SETUP_ENABLED=false

# Broadcast notifications
# SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
PUSH_PROVIDER=
EXPO_PUSH_ENDPOINT=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

GOOGLE_MAPS_API_KEY=
FLEET_REVERSE_GEOCODE_ENABLED=false
FLEET_REVERSE_GEOCODE_PROVIDER=nominatim
FLEET_REVERSE_GEOCODE_TIMEOUT_SECONDS=6
FLEET_REVERSE_GEOCODE_MIN_DISTANCE_KM=1
FLEET_REVERSE_GEOCODE_CACHE_TTL_DAYS=30
FLEET_REVERSE_GEOCODE_RATE_LIMIT_PER_MINUTE=30
FLEET_NOMINATIM_ENDPOINT=http://127.0.0.1:8088
FLEET_NOMINATIM_USER_AGENT="OblivionFindings/1.0"
FLEET_NOMINATIM_CONTACT_EMAIL=
FLEET_NOMINATIM_AUTO_INSTALL=false
FLEET_NOMINATIM_REGION_PBF_URL=https://download.geofabrik.de/australia-oceania/new-zealand-latest.osm.pbf
FLEET_NOMINATIM_PROJECT_DIR=/srv/nominatim-project
FLEET_TRIP_START_SPEED_KPH=5
FLEET_TRIP_STOP_SPEED_KPH=2
FLEET_TRIP_STOP_AFTER_MINUTES=5
FLEET_GEOFENCE_DEBOUNCE_MINUTES=5
FLEET_OFFLINE_AFTER_MINUTES=15
FLEET_SPEEDING_KPH=100
FLEET_IDLE_SPEED_KPH=3
FLEET_IDLE_AFTER_MINUTES=2
FLEET_IDLE_MAX_INCREMENT_MINUTES=15
FLEET_SCORE_HARSH_BRAKE=5
FLEET_SCORE_ACCEL=3
FLEET_SCORE_SPEEDING=4
FLEET_SCORE_IDLE=0.5
FLEET_TELEMETRY_RETENTION_DAYS=365
PERSONAL_LOCATION_RETENTION_DAYS=90
ASSET_TELEMETRY_SNAPSHOT_RETENTION_DAYS=365
ASSET_TELEMETRY_HISTORY_RETENTION_DAYS=730
# secret removed
