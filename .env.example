APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_INDEXING_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Sentry Error Monitoring (optional, recommended for production)
# Get your DSN from https://sentry.io/
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=oblivion_findings
DB_USERNAME=testUser
DB_PASSWORD='test101'

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# For production, use redis for better performance
QUEUE_CONNECTION=database
# QUEUE_CONNECTION=redis

# For production, use redis for better performance
CACHE_STORE=database
# CACHE_STORE=redis

# LLM (optional)
# Set LLM_DRIVER=openai and provide OPENAI_API_KEY to enable AI summaries.
LLM_DRIVER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Use 'predis' (composer package) or 'phpredis' (PHP extension)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Microsoft (Entra ID)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
MICROSOFT_TENANT_ID=

# Telemetry ingest
TELEMETRY_INGEST_TOKEN=

GOOGLE_MAPS_API_KEY=
FLEET_REVERSE_GEOCODE_ENABLED=false
FLEET_REVERSE_GEOCODE_MIN_DISTANCE_KM=1
FLEET_REVERSE_GEOCODE_CACHE_TTL_DAYS=30
FLEET_REVERSE_GEOCODE_RATE_LIMIT_PER_MINUTE=30
FLEET_TRIP_START_SPEED_KPH=5
FLEET_TRIP_STOP_SPEED_KPH=2
FLEET_TRIP_STOP_AFTER_MINUTES=5
FLEET_GEOFENCE_DEBOUNCE_MINUTES=5
FLEET_OFFLINE_AFTER_MINUTES=15
FLEET_SPEEDING_KPH=100
FLEET_IDLE_SPEED_KPH=3
FLEET_IDLE_AFTER_MINUTES=2
FLEET_IDLE_MAX_INCREMENT_MINUTES=15
FLEET_SCORE_HARSH_BRAKE=5
FLEET_SCORE_ACCEL=3
FLEET_SCORE_SPEEDING=4
FLEET_SCORE_IDLE=0.5
FLEET_TELEMETRY_RETENTION_DAYS=365
ASSET_TELEMETRY_SNAPSHOT_RETENTION_DAYS=365
ASSET_TELEMETRY_HISTORY_RETENTION_DAYS=730
# secret removed
