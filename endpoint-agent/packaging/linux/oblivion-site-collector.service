[Unit]
Description=Oblivion Findings Site Monitoring Hub
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/oblivion-collector
ExecStart=/opt/oblivion-collector/oblivion-site-collector --identity=/etc/oblivion-collector/collector.identity.json
Restart=always
RestartSec=10
# Exit 3: the hub was removed in Oblivion and wiped its saved logins. Stay stopped (S&D Phase B).
RestartPreventExitStatus=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
